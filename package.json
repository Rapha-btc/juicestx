{
  "name": "stx-juice-tests",
  "version": "1.0.0",
  "description": "Run unit tests on this project.",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "python3 tests/vault/build.py && vitest run -- --manifest ./tests/vault/.build/Clarinet.toml",
    "test:report": "python3 tests/vault/build.py && vitest run -- --manifest ./tests/vault/.build/Clarinet.toml --coverage --costs",
    "test:watch": "chokidar \"tests/**/*.ts\" \"contracts/**/*.clar\" -c \"npm run test:report\"",
    "test:vault": "python3 tests/vault/build.py && node tests/vault/runtime.mjs",
    "rv:vault:build": "python3 tests/vault/build.py --rv",
    "rv:vault": "rv tests/vault/.build-rv juice-sbtc-autoswap invariant --runs=1000",
    "test:vault:migration": "python3 tests/vault/build.py && node tests/vault/migration.mjs",
    "coverage:summary": "node tests/coverage-summary.mjs --uncovered",
    "rv:build": "python3 tests/rv/build.py",
    "rv:pool": "python3 tests/rv/build.py pool && node tests/rv/run.mjs pool",
    "rv:pool:no-zero": "python3 tests/rv/build.py pool --no-zero-stake && node tests/rv/run.mjs pool",
    "rv:vault:ext": "python3 tests/rv/build.py vault && node tests/rv/run.mjs vault",
    "test:v2": "python3 tests/vault/build.py --v2 && vitest run -- --manifest ./tests/vault/.build-v2/Clarinet.toml",
    "check:v2": "python3 tests/vault/build.py --v2 && cd tests/vault/.build-v2 && clarinet check",
    "test:vault:v2": "python3 tests/vault/build.py --v2 && JUICE_VAULT=v2 node tests/vault/runtime.mjs",
    "rv:vault:v2:build": "python3 tests/vault/build.py --rv --v2",
    "rv:vault:v2": "rv tests/vault/.build-rv-v2 juice-sbtc-autoswap invariant --runs=1000",
    "rv:vault:ext:v2": "python3 tests/rv/build.py vault --v2 && node tests/rv/run.mjs vault-v2",
    "test:rv-repro": "python3 tests/vault/build.py && vitest run tests/rv-repro-og-zero-seat.test.ts -- --manifest ./tests/vault/.build/Clarinet.toml"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@stacks/transactions": "^7.2.0",
    "@types/node": "^24.4.0",
    "chokidar-cli": "^3.0.0",
    "stxer": "^0.10.0",
    "tsx": "^4.22.4",
    "vitest": "^4.0.7",
    "vitest-environment-clarinet": "^3.0.0"
  },
  "devDependencies": {
    "@stacks/clarinet-sdk": "^3.21.0",
    "@stacks/rendezvous": "^1.0.0-rc.1"
  }
}
